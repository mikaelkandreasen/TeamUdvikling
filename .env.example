# Kopiér til .env (committes aldrig – .env står i .gitignore). I Dockhand sættes de samme variabler i stack'ens miljø.
U11_PORT=1020
# Tomt = byg lokalt fra repoet. Sæt for at bruge det udgivne image fra GHCR:
# U11_IMAGE=ghcr.io/DIT-GITHUB-BRUGERNAVN/u11-udvikling:0.2.0
SECRET_KEY=
COOKIE_SECURE=0
SETUP_TOKEN=
# Antal reverse proxies foran appen (1 ved Caddy/NPM/Traefik). VIGTIGT på internettet: giver korrekt klient-IP.
TRUSTED_PROXIES=0
# Husk denne enhed: antal dage uden kode/2FA (0 = slå funktionen fra)
REMEMBER_DAYS=30
# E-mail til nulstilling (valgfrit). Se README → "E-mail og nulstilling".
PUBLIC_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Bind kun til localhost hvis proxyen kører på samme maskine:
# U11_BIND=127.0.0.1
